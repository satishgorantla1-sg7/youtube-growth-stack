# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (Project Settings > API)
# The service-role key is server-only and required for connected research workers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEARCH_WORKER_ID=research-local
RESEARCH_WORKER_POLL_MS=2000

# OpenAI voice + synthesis (server-only)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=tts-1
OPENAI_VOICE=marin

# Research providers (server-only)
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
APIFY_YOUTUBE_ACTOR_ID=streamers/youtube-scraper

# YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# Safety and cost controls
MAX_RESEARCH_SOURCES=25
MAX_CONCURRENT_JOBS_PER_WORKSPACE=2
DAILY_CREDIT_LIMIT=100
